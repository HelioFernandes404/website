---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import { useTranslations } from "../i18n/utils";

interface Props {
    post: CollectionEntry<"blog">;
    older: CollectionEntry<"blog"> | null;
    newer: CollectionEntry<"blog"> | null;
    lang: "en" | "pt";
    canonicalUrl: string;
    alternateUrl?: string;
    blogBaseUrl: string;
    headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { post, older, newer, lang, canonicalUrl, alternateUrl, blogBaseUrl, headings = [] } = Astro.props;
const t = useTranslations(lang);
const dateFormatter = new Intl.DateTimeFormat(lang === "pt" ? "pt-BR" : "en-US", { dateStyle: "long", timeZone: "UTC" });
const readingMinutes = Math.max(1, Math.round(post.body.trim().split(/\s+/).length / 200));
const urlFor = (slug: string) => `${blogBaseUrl}${slug}/`;
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<Layout title={`${post.data.title} | Blog`} description={post.data.description} ogImage="/og-image.webp" canonicalUrl={canonicalUrl} readingModeEnabled={true} lang={lang} alternateUrl={alternateUrl}>
    <div class="blog-post-progress fixed inset-x-0 top-0 z-40 h-1 origin-left scale-x-0 bg-brand-lime" data-reading-progress aria-hidden="true"></div>
    <main class="blog-post-page min-h-screen">
        <section class="blog-post-hero border-b border-gray-100 bg-gray-50/70">
            <div class="mx-auto max-w-3xl px-6 py-16 md:py-20">
                <div class="flex flex-wrap items-center gap-3 font-mono text-sm uppercase tracking-wider text-brand-gray">
                    <span>{t("blogPost.kicker")}</span><span class="blog-post-chip rounded-full border border-gray-200 px-2 py-1 text-[11px] text-gray-600">{post.data.category}</span>
                </div>
                <h1 class="mt-3 text-4xl font-display font-bold tracking-tight lg:text-5xl">{post.data.title}</h1>
                <p class="blog-post-summary mt-4 text-lg text-gray-600">{post.data.lead ?? post.data.description}</p>
                <div class="mt-6 flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-wide text-gray-500"><time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time><span aria-hidden="true">•</span><span>{readingMinutes} {t("blogPost.minRead")}</span></div>
                {post.data.tags.length > 0 && <ul class="mt-6 flex flex-wrap gap-2">{post.data.tags.map((tag) => <li class="blog-post-tag rounded-full border border-gray-200 px-3 py-1 text-xs font-medium text-gray-600">{tag}</li>)}</ul>}
            </div>
        </section>
        <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
            <div class="blog-post-toolbar mb-8 flex flex-col gap-4 rounded-2xl border border-gray-200 bg-white/90 p-4 shadow-sm backdrop-blur md:flex-row md:items-center md:justify-between" data-reading-controls data-share-url={canonicalUrl} data-share-title={post.data.title} data-i18n-share-shared={t("blogPost.shareStatusShared")} data-i18n-share-cancelled={t("blogPost.shareStatusCancelled")} data-i18n-share-copied={t("blogPost.shareStatusCopied")} data-i18n-share-clipboard-fallback={t("blogPost.shareStatusClipboardFallback")} data-i18n-share-ready={t("blogPost.shareStatusReady")} data-i18n-copy-prompt={t("blogPost.copyPromptLabel")}>
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-4"><p class="font-mono text-xs uppercase tracking-[0.3em] text-gray-500">{t("blogPost.readingModeLabel")}</p><div class="flex flex-wrap gap-2" role="group" aria-label={t("blogPost.readingModeLabel")}>{["light", "dark", "system"].map((theme) => <button type="button" class="blog-post-toolbar-button rounded-full border border-gray-200 px-3 py-2 text-sm font-medium text-gray-600 transition-colors" data-theme-option={theme} aria-pressed="false">{theme[0].toUpperCase() + theme.slice(1)}</button>)}</div></div>
                <div class="flex flex-col items-start gap-3 md:items-end"><button type="button" class="blog-post-toolbar-button rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-gray-700 transition-colors" data-share-button>{t("blogPost.shareLink")}</button><p class="blog-post-share-status min-h-5 text-sm text-gray-500" data-share-status role="status" aria-live="polite"></p></div>
            </div>
            {tableOfContents.length > 0 && <nav class="blog-post-toc mb-8 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm" aria-label={lang === "pt" ? "Sumário do artigo" : "Article contents"}>
                <p class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-gray-500">{lang === "pt" ? "Neste artigo" : "In this article"}</p>
                <ol class="mt-3 grid gap-2">
                    {tableOfContents.map((heading) => <li class:list={[heading.depth === 3 && "pl-4"]}><a class="text-sm text-gray-600 underline decoration-brand-lime decoration-2 underline-offset-4" href={`#${heading.slug}`}>{heading.text}</a></li>)}
                </ol>
            </nav>}
            <article class="article-content blog-post-article -mx-6 rounded-2xl border border-gray-100 bg-white p-8 shadow-sm md:p-10"><slot /></article>
            {(older || newer) && <nav class="mt-12 grid gap-4 border-t border-gray-100 pt-8 sm:grid-cols-2" aria-label={t("blogPost.navAriaLabel")}>
                {older ? <a href={urlFor(older.slug)} class="blog-post-back-link hover-trigger group flex flex-col gap-1 rounded-2xl border border-gray-200 p-5 transition-[border-color,background-color,transform] duration-300 hover:-translate-y-0.5 hover:border-brand-lime hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-lime"><span class="font-mono text-xs uppercase tracking-wide text-gray-400">&lt;- {t("blogPost.previous")}</span><span class="font-medium group-hover:text-black">{older.data.title}</span></a> : <span />}
                {newer ? <a href={urlFor(newer.slug)} class="blog-post-back-link hover-trigger group flex flex-col items-end gap-1 rounded-2xl border border-gray-200 p-5 text-right transition-[border-color,background-color,transform] duration-300 hover:-translate-y-0.5 hover:border-brand-lime hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-lime sm:col-start-2"><span class="font-mono text-xs uppercase tracking-wide text-gray-400">{t("blogPost.next")} -&gt;</span><span class="font-medium group-hover:text-black">{newer.data.title}</span></a> : <span class="sm:col-start-2" />}
            </nav>}
            <a href={blogBaseUrl} class="blog-post-back-link hover-trigger mt-8 inline-flex items-center gap-2 rounded-lg border border-gray-200 px-5 py-2.5 font-medium transition-[border-color,background-color,color,transform] duration-300 hover:border-brand-lime hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-lime"><span aria-hidden="true">&lt;-</span>{t("blogPost.backToBlog")}</a>
        </section>
    </main>
</Layout>

<script>
    import { READING_THEME_STORAGE_KEY, getShareUrl, normalizeReadingThemePreference, resolveReadingTheme } from "../utils/blog-reading.js";
    const progressBar = document.querySelector<HTMLElement>("[data-reading-progress]");
    const updateProgress = () => { if (progressBar) { const scrollable = document.documentElement.scrollHeight - window.innerHeight; progressBar.style.transform = `scaleX(${scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0})`; } };
    updateProgress(); window.addEventListener("scroll", updateProgress, { passive: true }); window.addEventListener("resize", updateProgress);
    const controls = document.querySelector<HTMLElement>("[data-reading-controls]");
    if (controls) {
        const root = document.documentElement, meta = document.getElementById("theme-color-meta"), media = window.matchMedia("(prefers-color-scheme: dark)"), buttons = Array.from(controls.querySelectorAll<HTMLButtonElement>("[data-theme-option]")), share = controls.querySelector<HTMLButtonElement>("[data-share-button]"), status = controls.querySelector<HTMLElement>("[data-share-status]");
        const apply = (preference: string | null | undefined) => { const value = normalizeReadingThemePreference(preference), theme = resolveReadingTheme(value, media.matches); root.dataset.readingThemePreference = value; root.dataset.readingThemeActive = theme; if (meta instanceof HTMLMetaElement) meta.content = theme === "dark" ? "#121212" : "#ccff00"; buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.themeOption === value))); };
        const stored = () => { try { return normalizeReadingThemePreference(localStorage.getItem(READING_THEME_STORAGE_KEY)); } catch { return "system"; } };
        const save = (value: string | undefined) => { try { localStorage.setItem(READING_THEME_STORAGE_KEY, normalizeReadingThemePreference(value)); } catch {} apply(value); };
        const setStatus = (message: string) => { if (status) status.textContent = message; };
        apply(stored()); buttons.forEach((button) => button.addEventListener("click", () => save(button.dataset.themeOption)));
        media.addEventListener("change", () => { if (stored() === "system") apply("system"); });
        share?.addEventListener("click", async () => { const url = getShareUrl(controls.dataset.shareUrl, location.href), title = controls.dataset.shareTitle ?? document.title; if (navigator.share) try { await navigator.share({ title, text: title, url }); setStatus(controls.dataset.i18nShareShared ?? ""); return; } catch (error) { if (error instanceof DOMException && error.name === "AbortError") { setStatus(controls.dataset.i18nShareCancelled ?? ""); return; } } if (navigator.clipboard?.writeText) try { await navigator.clipboard.writeText(url); setStatus(controls.dataset.i18nShareCopied ?? ""); return; } catch { setStatus(controls.dataset.i18nShareClipboardFallback ?? ""); } window.prompt(controls.dataset.i18nCopyPrompt ?? "", url); setStatus(controls.dataset.i18nShareReady ?? ""); });
    }
</script>
