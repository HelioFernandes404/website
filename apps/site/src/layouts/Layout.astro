---
import SEOHead from "../components/SEOHead.astro";
import "../styles/global.css";
import { READING_THEME_STORAGE_KEY } from "../utils/blog-reading.js";
import { useTranslations, getHtmlLang } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  lang?: Lang;
  readingModeEnabled?: boolean;
  alternateUrl?: string;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  lang = "en",
  readingModeEnabled = false,
  alternateUrl,
}: Props = Astro.props;

const t = useTranslations(lang);
const pathname = Astro.url.pathname;
const basePrefix = lang === "pt" ? "/pt" : "";
const homeHref = `${basePrefix}/`;

const navLinks = [
  { href: homeHref, label: t("nav.home") },
  { href: `${basePrefix}/blog/`, label: t("nav.blog") },
  {
    href: lang === "en" ? "/projects/" : "/pt/projetos/",
    label: t("nav.projects"),
  },
];

const isActiveLink = (href: string) => {
  if (href === homeHref) {
    return pathname === homeHref;
  }

  return pathname.startsWith(href);
};

const alternateLangCode = lang === "en" ? "pt" : "en";
const contactHref =
  lang === "pt"
    ? "mailto:heliodevhub@gmail.com?subject=Contato%20via%20site"
    : "mailto:heliodevhub@gmail.com?subject=Contact%20via%20website";
---

<!doctype html>
<html
  lang={getHtmlLang(lang)}
  class="scroll-smooth"
  data-reading-mode-enabled={readingModeEnabled ? "true" : undefined}
  data-reading-theme-preference={readingModeEnabled ? "system" : undefined}
  data-reading-theme-active={readingModeEnabled ? "light" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta id="theme-color-meta" name="theme-color" content="#ccff00" />
    {
      readingModeEnabled && (
        <script
          is:inline
          define:vars={{
            readingThemeStorageKey: READING_THEME_STORAGE_KEY,
            readingThemeColorDark: "#121212",
            readingThemeColorLight: "#ccff00",
          }}
        >
          const normalizeReadingThemePreference = (value) => {
            if (value === "light" || value === "dark" || value === "system") {
              return value;
            }

            return "system";
          };

          const resolveReadingTheme = (preference, systemPrefersDark) => {
            const normalizedPreference = normalizeReadingThemePreference(preference);

            if (normalizedPreference === "system") {
              return systemPrefersDark ? "dark" : "light";
            }

            return normalizedPreference;
          };

          const root = document.documentElement;
          const themeColorMeta = document.getElementById("theme-color-meta");
          const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
          let storedPreference = "system";

          try {
            storedPreference = normalizeReadingThemePreference(
              window.localStorage.getItem(readingThemeStorageKey),
            );
          } catch {
            storedPreference = "system";
          }

          const activeTheme = resolveReadingTheme(storedPreference, mediaQuery.matches);

          root.dataset.readingThemePreference = storedPreference;
          root.dataset.readingThemeActive = activeTheme;

          if (themeColorMeta instanceof HTMLMetaElement) {
            themeColorMeta.content =
              activeTheme === "dark"
                ? readingThemeColorDark
                : readingThemeColorLight;
          }
        </script>
      )
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/space-grotesk-latin.woff2"
      crossorigin
    />
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalUrl={canonicalUrl}
      lang={lang}
      alternateUrl={alternateUrl}
    />
  </head>
  <body class="selection:bg-brand-lime selection:text-black">
    <a class="skip-link" href="#main-content">{t("layout.skipToContent")}</a>
    <div class="noise-overlay"></div>

    <div class="relative flex min-h-screen flex-col">
      <header
        id="main-header"
        class="site-header fixed top-0 z-50 w-full border-b border-transparent bg-white/80 backdrop-blur-md transition-[border-color,box-shadow,background-color] duration-300"
      >
        <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6">
          <a href={homeHref} class="site-brand-link group flex items-center gap-2 hover-trigger">
            <div
              class="site-brand-mark flex h-8 w-8 items-center justify-center rounded-lg bg-black font-display text-sm font-bold text-white transition-colors duration-300 group-hover:bg-brand-lime group-hover:text-black"
            >
              H
            </div>
            <span
              class="site-brand-wordmark font-display text-lg font-bold tracking-tight transition-[letter-spacing,color] duration-300 group-hover:tracking-wide"
            >
              Helio.dev
            </span>
          </a>

          <nav
            class="site-nav hidden items-center space-x-8 font-mono text-sm font-medium text-gray-500 md:flex"
            aria-label="Primary"
          >
            {
              navLinks.map((link) => {
                const active = isActiveLink(link.href);

                return (
                  <a
                    href={link.href}
                    class:list={[
                      "relative group py-2 transition-colors hover:text-black hover-trigger",
                      active && "text-black",
                    ]}
                    aria-current={active ? "page" : undefined}
                  >
                    <span class="relative z-10">{link.label}</span>
                    <span
                      class:list={[
                        "absolute bottom-0 left-0 h-0.5 bg-brand-lime transition-[width] duration-300",
                        active ? "w-full" : "w-0 group-hover:w-full",
                      ]}
                    ></span>
                  </a>
                );
              })
            }
            {
              alternateUrl && (
                <a
                  href={alternateUrl}
                  hreflang={alternateLangCode}
                  class="hover-trigger relative py-2 uppercase tracking-wide transition-colors hover:text-black"
                >
                  {t("layout.switchLanguage")}
                </a>
              )
            }
            <a
              href={contactHref}
              class="site-header-contact hover-trigger inline-flex items-center gap-2 rounded-full bg-black px-4 py-2 text-xs font-semibold uppercase tracking-wide text-white transition-[background-color,color,transform] duration-300 hover:-translate-y-0.5 hover:bg-brand-lime hover:text-black"
            >
              {t("layout.contact")}
              <span aria-hidden="true">-&gt;</span>
            </a>
          </nav>

          <button
            id="mobile-menu-button"
            type="button"
            class="hover-trigger p-2 md:hidden"
            aria-label={t("layout.openMenu")}
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-haspopup="true"
            data-open-label={t("layout.openMenu")}
            data-close-label={t("layout.closeMenu")}
          >
            <span class="sr-only">{t("layout.openMenu")}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              class="h-6 w-6"
              data-menu-icon="open"
              aria-hidden="true"
            >
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              class="hidden h-6 w-6"
              data-menu-icon="close"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>

        <div
          id="mobile-menu"
          class="site-mobile-menu absolute left-0 top-full hidden w-full origin-top border-b border-gray-100 bg-white p-6 shadow-2xl animate-fade-in-up md:hidden"
          aria-hidden="true"
        >
          <nav class="flex flex-col space-y-4 font-display text-2xl font-bold" aria-label="Mobile primary">
            {
              navLinks.map((link) => {
                const active = isActiveLink(link.href);

                return (
                  <a
                    href={link.href}
                    class:list={[
                      "mobile-menu-link transition-colors hover:text-brand-lime",
                      active && "text-brand-lime",
                    ]}
                    aria-current={active ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                );
              })
            }
            {
              alternateUrl && (
                <a
                  href={alternateUrl}
                  hreflang={alternateLangCode}
                  class="transition-colors hover:text-brand-lime"
                >
                  {t("layout.switchLanguage")}
                </a>
              )
            }
            <a
              href={contactHref}
              class="mobile-menu-contact inline-flex w-fit items-center gap-2 rounded-full bg-black px-5 py-3 text-base font-semibold text-white transition-colors hover:bg-brand-lime hover:text-black"
            >
              {t("layout.contact")}
              <span aria-hidden="true">-&gt;</span>
            </a>
          </nav>
        </div>
      </header>

      <div id="main-content" class="flex-1 pt-20" tabindex="-1">
        <slot />
      </div>

      <footer class="site-footer border-t border-gray-200 bg-gray-50 py-12">
        <div
          class="mx-auto flex max-w-7xl flex-col gap-8 px-6 md:flex-row md:items-end md:justify-between"
        >
          <div class="text-center md:text-left">
            <span class="font-display text-2xl font-bold tracking-tight">Helio.dev</span>
            <p class="mt-2 text-sm text-gray-500">
              {t("layout.footerCopyright")}
            </p>
          </div>

          <div class="flex flex-col items-center gap-4 sm:flex-row md:items-end">
            <a
              href={contactHref}
              class="site-footer-contact hover-trigger inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-gray-600 transition-colors hover:text-black"
            >
              {t("layout.contact")}
              <span aria-hidden="true">-&gt;</span>
            </a>
            <button
              id="back-to-top"
              type="button"
              class="site-back-to-top hover-trigger flex h-12 w-12 items-center justify-center rounded-full border border-gray-200 bg-white shadow-sm transition-[transform,border-color,background-color,color,box-shadow] duration-300 hover:-translate-y-1 hover:border-black hover:bg-black hover:text-brand-lime"
              aria-label={t("layout.backToTop")}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="h-5 w-5"
                aria-hidden="true"
              >
                <path d="m6 12 6-6 6 6"></path>
                <path d="M12 18V6"></path>
              </svg>
            </button>
          </div>
        </div>
      </footer>
    </div>

    <script is:inline>
      const header = document.getElementById("main-header");
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (header instanceof HTMLElement) {
        let headerUpdateFrame = 0;

        const updateHeaderState = () => {
          headerUpdateFrame = 0;

          if (window.scrollY > 50) {
            header.classList.add("shadow-sm", "border-gray-100");
            header.classList.remove("border-transparent");
          } else {
            header.classList.remove("shadow-sm", "border-gray-100");
            header.classList.add("border-transparent");
          }
        };

        const scheduleHeaderUpdate = () => {
          if (headerUpdateFrame === 0) {
            headerUpdateFrame = window.requestAnimationFrame(updateHeaderState);
          }
        };

        updateHeaderState();
        window.addEventListener("scroll", scheduleHeaderUpdate, { passive: true });
      }

      const revealElements = Array.from(
        document.querySelectorAll(".reveal-on-scroll"),
      );

      if (revealElements.length > 0) {
        if (prefersReducedMotion) {
          revealElements.forEach((element) =>
            element.classList.add("is-visible"),
          );
        } else if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
          );

          revealElements.forEach((element) => observer.observe(element));
        } else {
          revealElements.forEach((element) =>
            element.classList.add("is-visible"),
          );
        }
      }

      const mobileMenu = document.getElementById("mobile-menu");
      const mobileMenuButton = document.getElementById("mobile-menu-button");

      if (
        mobileMenu instanceof HTMLElement &&
        mobileMenuButton instanceof HTMLButtonElement
      ) {
        const openIcon = mobileMenuButton.querySelector('[data-menu-icon="open"]');
        const closeIcon = mobileMenuButton.querySelector('[data-menu-icon="close"]');
        const openLabel = mobileMenuButton.dataset.openLabel ?? "Open menu";
        const closeLabel = mobileMenuButton.dataset.closeLabel ?? "Close menu";

        const setMobileMenuState = (isOpen, returnFocus = false) => {
          mobileMenu.classList.toggle("hidden", !isOpen);
          mobileMenu.setAttribute("aria-hidden", String(!isOpen));
          mobileMenuButton.setAttribute("aria-expanded", String(isOpen));
          mobileMenuButton.setAttribute("aria-label", isOpen ? closeLabel : openLabel);
          openIcon?.classList.toggle("hidden", isOpen);
          closeIcon?.classList.toggle("hidden", !isOpen);
          document.body.classList.toggle("mobile-menu-open", isOpen);

          if (returnFocus) {
            mobileMenuButton.focus();
          }
        };

        setMobileMenuState(false);

        mobileMenuButton.addEventListener("click", () => {
          const isOpen = mobileMenuButton.getAttribute("aria-expanded") === "true";
          setMobileMenuState(!isOpen);
        });

        mobileMenu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            setMobileMenuState(false);
          });
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && mobileMenuButton.getAttribute("aria-expanded") === "true") {
            setMobileMenuState(false, true);
          }
        });

        document.addEventListener("click", (event) => {
          if (
            mobileMenuButton.getAttribute("aria-expanded") === "true" &&
            event.target instanceof Node &&
            !header?.contains(event.target)
          ) {
            setMobileMenuState(false);
          }
        });

        window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
          if (event.matches) {
            setMobileMenuState(false);
          }
        });
      }

      const backToTopButton = document.getElementById("back-to-top");

      if (backToTopButton instanceof HTMLButtonElement) {
        backToTopButton.addEventListener("click", () => {
          window.scrollTo({
            top: 0,
            behavior: prefersReducedMotion ? "auto" : "smooth",
          });
        });
      }
    </script>
  </body>
</html>
