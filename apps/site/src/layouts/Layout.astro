---
import SEOHead from "../components/SEOHead.astro";
import "../styles/global.css";
import "../styles/portfolio.css";
import ReadingTheme from "../components/ReadingTheme.astro";
import { profile } from "../data/profile";
import type { Lang } from "../i18n/ui";
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  lang?: Lang;
  readingModeEnabled?: boolean;
  alternateUrl?: string;
}
const {
  title,
  description,
  ogImage,
  canonicalUrl,
  readingModeEnabled = false,
} = Astro.props;
const lang = "en";
const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/projects/", label: "Work" },
  { href: "/#services", label: "Expertise" },
  { href: "/#about", label: "About" },
  { href: "/blog/", label: "Writing" },
];
---

<!doctype html>
<html
  lang="en-US"
  data-reading-mode-enabled={readingModeEnabled ? "true" : undefined}
  data-reading-theme-preference={readingModeEnabled ? "system" : undefined}
  data-reading-theme-active={readingModeEnabled ? "light" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta id="theme-color-meta" name="theme-color" content="#f5f4ef" />
    {readingModeEnabled && <ReadingTheme />}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/space-grotesk-latin.woff2"
      crossorigin
    />
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalUrl={canonicalUrl}
      lang={lang}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header id="main-header" class="site-header portfolio-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="Hélio Fernandes — home"
          ><span class="brand-mark" aria-hidden="true">hf<span>.</span></span
          ><span class="brand-name"
            >Hélio Fernandes<span>SRE & DevOps Engineer</span></span
          ></a
        >
        <nav class="desktop-nav" aria-label="Primary navigation">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                aria-current={
                  pathname.startsWith(link.href) ? "page" : undefined
                }
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <div class="header-actions">
          <a href="/#contact" class="button button-primary header-contact"
            >Let's talk <span aria-hidden="true">↗</span></a
          ><button
            id="mobile-menu-button"
            class="menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-controls="mobile-menu"
            aria-expanded="false"><span aria-hidden="true">☰</span></button>
        </div>
      </div>
      <nav
        id="mobile-menu"
        class="mobile-nav wrap"
        aria-label="Mobile navigation"
        hidden
      >
        {
          navLinks.map((link) => (
            <a href={link.href}>
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
        <a href="/#contact">Contact<span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <div id="main-content" tabindex="-1"><slot /></div>
    <footer class="portfolio-footer site-footer">
      <div class="wrap footer-top">
        <a class="brand" href="/"
          ><span class="brand-mark" aria-hidden="true">hf<span>.</span></span
          ><span>Hélio Fernandes</span></a
        ><p>Software thinking. Production responsibility.</p><a
          class="text-link"
          href="/#contact">Get in touch <span aria-hidden="true">↗</span></a>
      </div>
      <div class="wrap footer-bottom">
        <p>© {new Date().getFullYear()} Hélio Fernandes</p><nav
          aria-label="Social and profile links"
        >
          <a href={profile.linkedin}>LinkedIn ↗</a><a href={profile.github}
            >GitHub ↗</a
          ><a href={profile.hub}>Link hub ↗</a>
        </nav><a href="#main-content" class="back-to-top"
          >Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLElement>("#mobile-menu");
      const toggle = document.querySelector<HTMLButtonElement>(
        "#mobile-menu-button",
      );
      if (menu && toggle) {
        const close = (returnFocus = false) => {
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", "Open menu");
          if (returnFocus) toggle.focus();
        };
        toggle.addEventListener("click", () => {
          const open = toggle.getAttribute("aria-expanded") !== "true";
          menu.hidden = !open;
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        });
        menu
          .querySelectorAll("a")
          .forEach((link) => link.addEventListener("click", () => close()));
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !menu.hidden) close(true);
        });
        document.addEventListener("click", (event) => {
          if (
            event.target instanceof Node &&
            !document.getElementById("main-header")?.contains(event.target)
          )
            close();
        });
        document.addEventListener("focusin", (event) => {
          if (
            event.target instanceof Node &&
            !document.getElementById("main-header")?.contains(event.target)
          )
            close();
        });
        window
          .matchMedia("(min-width: 900px)")
          .addEventListener("change", (event) => {
            if (event.matches) close();
          });
      }
    </script>
    <noscript
      ><style>
        .menu-toggle {
          display: none;
        }
        .mobile-nav[hidden] {
          display: flex !important;
        }
        @media (min-width: 900px) {
          .mobile-nav[hidden] {
            display: none !important;
          }
        }
      </style></noscript
    >
  </body>
</html>
