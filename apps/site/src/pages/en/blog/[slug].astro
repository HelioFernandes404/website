---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { useTranslations, stripLocalePrefix } from "../../../i18n/utils";

const lang = "en" as const;

export async function getStaticPaths() {
    const posts = (await getCollection("blog", ({ id }) => id.startsWith("en/")))
        .map((post) => ({ ...post, slug: stripLocalePrefix(post.slug, "en") }))
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    return posts.map((post, index) => ({
        params: { slug: post.slug },
        props: {
            post,
            older: posts[index + 1] ?? null,
            newer: posts[index - 1] ?? null,
            alternateUrl: `/blog/${post.slug}/`,
        },
    }));
}

interface Props {
    post: CollectionEntry<"blog">;
    older: CollectionEntry<"blog"> | null;
    newer: CollectionEntry<"blog"> | null;
    alternateUrl: string;
}

const { post, older, newer, alternateUrl } = Astro.props as Props;
const { Content } = await post.render();
const t = useTranslations(lang);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
    dateStyle: "long",
    timeZone: "UTC",
});

const readingMinutes = Math.max(
    1,
    Math.round(post.body.trim().split(/\s+/).length / 200),
);

const title = `${post.data.title} | Blog`;
const description = post.data.description;
const ogImage = "/og-image.webp";
const canonicalUrl = `https://heliosuns404.com/en/blog/${post.slug}/`;
---

<Layout
    title={title}
    description={description}
    ogImage={ogImage}
    canonicalUrl={canonicalUrl}
    readingModeEnabled={true}
    lang={lang}
    alternateUrl={alternateUrl}
>
    <div
        class="blog-post-progress fixed inset-x-0 top-0 z-40 h-1 origin-left scale-x-0 bg-brand-lime"
        data-reading-progress
        aria-hidden="true"
    >
    </div>

    <main class="blog-post-page min-h-screen">
        <section class="blog-post-hero border-b border-gray-100 bg-gray-50/70">
            <div class="mx-auto max-w-3xl px-6 py-16 md:py-20">
                <div class="flex flex-wrap items-center gap-3 font-mono text-sm uppercase tracking-wider text-brand-gray">
                    <span>{t("blogPost.kicker")}</span>
                    <span class="blog-post-chip rounded-full border border-gray-200 px-2 py-1 text-[11px] text-gray-600">
                        {post.data.category}
                    </span>
                </div>
                <h1 class="mt-3 text-4xl font-display font-bold tracking-tight lg:text-5xl">
                    {post.data.title}
                </h1>
                <p class="blog-post-summary mt-4 text-lg text-gray-600">
                    {post.data.lead ?? post.data.description}
                </p>
                <div class="mt-6 flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-wide text-gray-500">
                    <time datetime={post.data.pubDate.toISOString()}>
                        {dateFormatter.format(post.data.pubDate)}
                    </time>
                    <span aria-hidden="true">•</span>
                    <span>{readingMinutes} {t("blogPost.minRead")}</span>
                </div>
                {
                    post.data.tags.length > 0 && (
                        <ul class="mt-6 flex flex-wrap gap-2">
                            {post.data.tags.map((tag) => (
                                <li class="blog-post-tag rounded-full border border-gray-200 px-3 py-1 text-xs font-medium text-gray-600">
                                    {tag}
                                </li>
                            ))}
                        </ul>
                    )
                }
            </div>
        </section>

        <section class="mx-auto max-w-3xl px-6 py-16 md:py-20">
            <div
                class="blog-post-toolbar sticky top-24 z-20 mb-8 flex flex-col gap-4 rounded-2xl border border-gray-200 bg-white/90 p-4 shadow-sm backdrop-blur md:flex-row md:items-center md:justify-between"
                data-reading-controls
                data-share-url={canonicalUrl}
                data-share-title={post.data.title}
                data-i18n-share-shared={t("blogPost.shareStatusShared")}
                data-i18n-share-cancelled={t("blogPost.shareStatusCancelled")}
                data-i18n-share-copied={t("blogPost.shareStatusCopied")}
                data-i18n-share-clipboard-fallback={t("blogPost.shareStatusClipboardFallback")}
                data-i18n-share-ready={t("blogPost.shareStatusReady")}
                data-i18n-copy-prompt={t("blogPost.copyPromptLabel")}
            >
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-4">
                    <p class="font-mono text-xs uppercase tracking-[0.3em] text-gray-500">
                        {t("blogPost.readingModeLabel")}
                    </p>
                    <div class="flex flex-wrap gap-2" role="group" aria-label={t("blogPost.readingModeLabel")}>
                        <button
                            type="button"
                            class="blog-post-toolbar-button rounded-full border border-gray-200 px-3 py-2 text-sm font-medium text-gray-600 transition-colors"
                            data-theme-option="light"
                            aria-pressed="false"
                        >
                            Light
                        </button>
                        <button
                            type="button"
                            class="blog-post-toolbar-button rounded-full border border-gray-200 px-3 py-2 text-sm font-medium text-gray-600 transition-colors"
                            data-theme-option="dark"
                            aria-pressed="false"
                        >
                            Dark
                        </button>
                        <button
                            type="button"
                            class="blog-post-toolbar-button rounded-full border border-gray-200 px-3 py-2 text-sm font-medium text-gray-600 transition-colors"
                            data-theme-option="system"
                            aria-pressed="false"
                        >
                            System
                        </button>
                    </div>
                </div>

                <div class="flex flex-col items-start gap-3 md:items-end">
                    <button
                        type="button"
                        class="blog-post-toolbar-button rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-gray-700 transition-colors"
                        data-share-button
                    >
                        {t("blogPost.shareLink")}
                    </button>
                    <p
                        class="blog-post-share-status min-h-5 text-sm text-gray-500"
                        data-share-status
                        role="status"
                        aria-live="polite"
                    ></p>
                </div>
            </div>

            <article class="article-content blog-post-article rounded-2xl border border-gray-100 bg-white p-8 shadow-sm md:p-10">
                <Content />
            </article>

            {
                (older || newer) && (
                    <nav
                        class="mt-12 grid gap-4 border-t border-gray-100 pt-8 sm:grid-cols-2"
                        aria-label={t("blogPost.navAriaLabel")}
                    >
                        {older ? (
                            <a
                                href={`/en/blog/${older.slug}/`}
                                class="blog-post-back-link hover-trigger group flex flex-col gap-1 rounded-2xl border border-gray-200 p-5 transition-[border-color,background-color,transform] duration-300 hover:-translate-y-0.5 hover:border-brand-lime hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-lime"
                            >
                                <span class="font-mono text-xs uppercase tracking-wide text-gray-400">
                                    &lt;- {t("blogPost.previous")}
                                </span>
                                <span class="font-medium group-hover:text-black">
                                    {older.data.title}
                                </span>
                            </a>
                        ) : (
                            <span />
                        )}
                        {newer ? (
                            <a
                                href={`/en/blog/${newer.slug}/`}
                                class="blog-post-back-link hover-trigger group flex flex-col items-end gap-1 rounded-2xl border border-gray-200 p-5 text-right transition-[border-color,background-color,transform] duration-300 hover:-translate-y-0.5 hover:border-brand-lime hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-lime sm:col-start-2"
                            >
                                <span class="font-mono text-xs uppercase tracking-wide text-gray-400">
                                    {t("blogPost.next")} -&gt;
                                </span>
                                <span class="font-medium group-hover:text-black">
                                    {newer.data.title}
                                </span>
                            </a>
                        ) : (
                            <span class="sm:col-start-2" />
                        )}
                    </nav>
                )
            }

            <a
                href="/en/blog/"
                class="blog-post-back-link hover-trigger mt-8 inline-flex items-center gap-2 rounded-lg border border-gray-200 px-5 py-2.5 font-medium transition-[border-color,background-color,color,transform] duration-300 hover:border-brand-lime hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-lime"
            >
                <span aria-hidden="true">&lt;-</span>
                {t("blogPost.backToBlog")}
            </a>
        </section>
    </main>
</Layout>

<script>
    import {
        READING_THEME_STORAGE_KEY,
        getShareUrl,
        normalizeReadingThemePreference,
        resolveReadingTheme,
    } from "../../../utils/blog-reading.js";

    const progressBar = document.querySelector("[data-reading-progress]");

    if (progressBar instanceof HTMLElement) {
        const updateProgress = () => {
            const scrollable =
                document.documentElement.scrollHeight - window.innerHeight;
            const ratio =
                scrollable > 0
                    ? Math.min(1, Math.max(0, window.scrollY / scrollable))
                    : 0;
            progressBar.style.transform = `scaleX(${ratio})`;
        };

        updateProgress();
        window.addEventListener("scroll", updateProgress, { passive: true });
        window.addEventListener("resize", updateProgress);
    }

    const readingControls = document.querySelector("[data-reading-controls]");

    if (readingControls instanceof HTMLElement) {
        const root = document.documentElement;
        const themeColorMeta = document.getElementById("theme-color-meta");
        const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
        const themeButtons = Array.from(
            readingControls.querySelectorAll("[data-theme-option]"),
        );
        const shareButton = readingControls.querySelector("[data-share-button]");
        const shareStatus = readingControls.querySelector("[data-share-status]");

        const updateThemeState = (
            nextPreference: string | null | undefined,
        ) => {
            const normalizedPreference =
                normalizeReadingThemePreference(nextPreference);
            const activeTheme = resolveReadingTheme(
                normalizedPreference,
                mediaQuery.matches,
            );

            root.dataset.readingThemePreference = normalizedPreference;
            root.dataset.readingThemeActive = activeTheme;

            if (themeColorMeta instanceof HTMLMetaElement) {
                themeColorMeta.content =
                    activeTheme === "dark" ? "#121212" : "#ccff00";
            }

            themeButtons.forEach((button) => {
                if (button instanceof HTMLButtonElement) {
                    button.setAttribute(
                        "aria-pressed",
                        String(
                            button.dataset.themeOption === normalizedPreference,
                        ),
                    );
                }
            });
        };

        const readStoredPreference = () => {
            try {
                return normalizeReadingThemePreference(
                    window.localStorage.getItem(READING_THEME_STORAGE_KEY),
                );
            } catch {
                return "system";
            }
        };

        const persistPreference = (
            nextPreference: string | null | undefined,
        ) => {
            const normalizedPreference =
                normalizeReadingThemePreference(nextPreference);

            try {
                window.localStorage.setItem(
                    READING_THEME_STORAGE_KEY,
                    normalizedPreference,
                );
            } catch {
                return updateThemeState(normalizedPreference);
            }

            updateThemeState(normalizedPreference);
        };

        const updateShareStatus = (message: string) => {
            if (shareStatus instanceof HTMLElement) {
                shareStatus.textContent = message;
            }
        };

        updateThemeState(readStoredPreference());

        themeButtons.forEach((button) => {
            if (!(button instanceof HTMLButtonElement)) {
                return;
            }

            button.addEventListener("click", () => {
                persistPreference(button.dataset.themeOption);
            });
        });

        const handleSystemThemeChange = () => {
            if (readStoredPreference() === "system") {
                updateThemeState("system");
            }
        };

        if (typeof mediaQuery.addEventListener === "function") {
            mediaQuery.addEventListener("change", handleSystemThemeChange);
        } else {
            mediaQuery.onchange = handleSystemThemeChange;
        }

        if (shareButton instanceof HTMLButtonElement) {
            shareButton.addEventListener("click", async () => {
                const shareUrl = getShareUrl(
                    readingControls.dataset.shareUrl,
                    window.location.href,
                );
                const shareTitle =
                    readingControls.dataset.shareTitle ?? document.title;

                if (typeof navigator.share === "function") {
                    try {
                        await navigator.share({
                            title: shareTitle,
                            text: shareTitle,
                            url: shareUrl,
                        });
                        updateShareStatus(readingControls.dataset.i18nShareShared ?? "");
                        return;
                    } catch (error) {
                        if (
                            error instanceof DOMException &&
                            error.name === "AbortError"
                        ) {
                            updateShareStatus(readingControls.dataset.i18nShareCancelled ?? "");
                            return;
                        }
                    }
                }

                if (navigator.clipboard?.writeText) {
                    try {
                        await navigator.clipboard.writeText(shareUrl);
                        updateShareStatus(readingControls.dataset.i18nShareCopied ?? "");
                        return;
                    } catch {
                        updateShareStatus(
                            readingControls.dataset.i18nShareClipboardFallback ?? "",
                        );
                    }
                }

                window.prompt(readingControls.dataset.i18nCopyPrompt ?? "", shareUrl);
                updateShareStatus(readingControls.dataset.i18nShareReady ?? "");
            });
        }
    }
</script>
