---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ContactCallout from "../../components/ContactCallout.astro";
import { stripLocalePrefix } from "../../i18n/utils";
const posts = (
  await getCollection("blog", ({ id }) => id.startsWith("en/"))
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  dateStyle: "medium",
  timeZone: "UTC",
});
---

<Layout
  title="Writing on SRE, DevOps & Architecture — Hélio Fernandes"
  description="Field notes on reliability, observability, software architecture, and delivery. Real investigations, technical decisions, and lessons from production."
  canonicalUrl="https://heliosuns404.com/blog/"
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow"><a href="/">Home</a> / Field notes</p><h1>
          Lessons from<br />building and operating.
        </h1><p class="page-description">
          Investigations, architecture decisions, and practical notes from
          working with real systems. Written to make the reasoning useful to
          someone else.
        </p>
      </div>
    </section><section class="wrap blog-archive" aria-label="Articles">
      <div class="writing-list">
        {
          posts.map((post) => (
            <article>
              <a href={`/blog/${stripLocalePrefix(post.slug, "en")}/`}>
                <>
                  <div class="writing-meta">
                    <>
                      <span>{post.data.category}</span>
                      <time datetime={post.data.pubDate.toISOString()}>
                        {dateFormatter.format(post.data.pubDate)}
                      </time>
                      <span>
                        {Math.max(
                          1,
                          Math.round(
                            post.body.trim().split(/\s+/).length / 200,
                          ),
                        )}{" "}
                        min read
                      </span>
                    </>
                  </div>
                  <div>
                    <>
                      <h2>{post.data.title}</h2>
                      <p>{post.data.description}</p>
                      <ul class="tech-tags" aria-label="Topics">
                        {post.data.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    </>
                  </div>
                  <span class="circle-arrow" aria-hidden="true">
                    ↗
                  </span>
                </>
              </a>
            </article>
          ))
        }
      </div>
    </section><ContactCallout
      title="Have a related problem to work through?"
      description="I'd be glad to hear about the system you're building or the challenge you're investigating."
    />
  </main>
</Layout>
