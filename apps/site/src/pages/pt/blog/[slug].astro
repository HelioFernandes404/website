---
import { getCollection } from "astro:content";
import { stripLocalePrefix } from "../../../i18n/utils";
export async function getStaticPaths() {
  return (await getCollection("blog", ({ id }) => id.startsWith("pt/"))).map(
    (entry) => ({ params: { slug: stripLocalePrefix(entry.slug, "pt") } }),
  );
}
return Astro.redirect(`/blog/${Astro.params.slug}/`, 301);
---
