---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactForm from "../components/ContactForm.astro";
import {
  profile,
  expertise,
  experience,
  skills,
  testimonials,
} from "../data/profile";
import { stripLocalePrefix } from "../i18n/utils";
const projects = (
  await getCollection("projects", ({ id }) => id.startsWith("en/"))
).sort((a, b) => {
  if (a.slug.endsWith("systemframe")) return -1;
  if (b.slug.endsWith("systemframe")) return 1;
  return a.data.order - b.data.order;
});
const posts = (
  await getCollection("blog", ({ id }) => id.startsWith("en/"))
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const date = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title="Hélio Fernandes — SRE, DevOps & Software Engineering"
  description={profile.description}
  canonicalUrl="https://heliosuns404.com/"
>
  <main>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">
          <span class="status-dot" aria-hidden="true"></span>Software thinking.
          Production responsibility.
        </p>
        <h1 id="hero-title">Good software.<br /><em>Reliable systems.</em></h1>
        <p class="hero-intro">
          I'm Hélio, an <strong>SRE & DevOps engineer</strong> with a foundation in
          software engineering. I connect code, infrastructure, and operations to
          help teams build and run dependable systems.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#contact"
            >Let's talk about your challenge <span aria-hidden="true">↗</span
            ></a
          ><a class="text-link" href="#projects"
            >Explore my work <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-socials">
          <a href={profile.linkedin}
            >LinkedIn <span aria-hidden="true">↗</span></a
          ><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a
          ><span>From code to production</span>
        </div>
      </div>
      <figure class="hero-portrait">
        <div class="portrait-image">
          <img
            src="/eu-portrait.webp"
            alt="Hélio Fernandes, SRE and DevOps engineer"
            width="768"
            height="960"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption>
          <span>Hélio Fernandes</span><span>Development → Operations</span>
        </figcaption>
        <span class="portrait-note" aria-hidden="true"
          >Built to work.<br />Ready to evolve.</span
        >
      </figure>
    </section>

    <section class="proof-band" aria-label="Results from selected case studies">
      <div class="wrap proof-grid">
        <p class="proof-intro">
          Engineering in practice.<br /><span>Results with context.</span>
        </p><a href="/projects/dai-tec-ai/"
          ><strong>80<span>%</span></strong><span
            >less deployment time<small>Dai Tec AI · 40 → 8 minutes ↗</small
            ></span
          ></a
        ><a href="/projects/systemframe/"
          ><strong>60<span>%</span></strong><span
            >less time to recover<small>SystemFrame · 50 → 20 minutes ↗</small
            ></span
          ></a
        ><a href="/projects/systemframe/"
          ><strong>12<span>+</span></strong><span
            >clients on one platform<small>SystemFrame · 390+ endpoints ↗</small
            ></span
          ></a>
      </div>
    </section>

    <section id="projects" class="section wrap" aria-labelledby="work-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / Selected work</p><h2 id="work-title">
            Real systems.<br /><em>Considered decisions.</em>
          </h2>
        </div><div class="section-heading-aside">
          <p>
            The problem, the engineering decisions, and what changed in
            production.
          </p><a class="text-link" href="/projects/"
            >All projects <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="projects-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section
      id="services"
      class="expertise-section section"
      aria-labelledby="expertise-title"
    >
      <div class="wrap">
        <div class="section-heading">
          <div>
            <p class="eyebrow">02 / How I can help</p><h2 id="expertise-title">
              From application code.<br /><em>To production.</em>
            </h2>
          </div><p class="section-heading-aside">
            Software, delivery, and reliability are connected. My experience
            spans all three.
          </p>
        </div>
        <div class="expertise-grid">
          {
            expertise.map((item, index) => (
              <article>
                <>
                  <span class="expertise-number" aria-hidden="true">
                    0{index + 1}
                  </span>
                  <p class="eyebrow">{item.label}</p>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <p class="expertise-evidence">{item.evidence}</p>
                </>
              </article>
            ))
          }
        </div>
        <a class="text-link" href="#contact"
          >Tell me where your team needs support <span aria-hidden="true"
            >↗</span
          ></a
        >
      </div>
    </section>

    <section
      id="about"
      class="section wrap about-section"
      aria-labelledby="about-title"
    >
      <div class="about-intro">
        <p class="eyebrow">03 / Background & experience</p><h2 id="about-title">
          A software foundation.<br /><em>A reliability mindset.</em>
        </h2><p>
          I started in software engineering, building services, integrations,
          and the delivery pipelines behind them. My work grew into SRE and
          DevOps: understanding how those systems behave, fail, and recover in
          production.
        </p><p>
          That foundation stays with me. I approach infrastructure with a
          developer's understanding of the application, and development with an
          operator's understanding of what happens after deployment.
        </p><a class="text-link" href={profile.linkedin}
          >More about my experience on LinkedIn <span aria-hidden="true">↗</span
          ></a>
      </div>
      <div class="experience">
        <p class="eyebrow">Experience through projects</p><ol>
          {
            experience.map((item) => (
              <li>
                <a class="experience-project" href={item.href}>
                  {item.project} <span aria-hidden="true">↗</span>
                </a>
                {item.employer && (
                  <p>
                    {item.jobTitle}
                    {item.jobTitle && " · "}
                    {item.employer}
                  </p>
                )}
                <p>{item.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="skills-section" aria-labelledby="skills-title">
      <div class="wrap">
        <div class="skills-heading">
          <p class="eyebrow">The tools behind the work</p><h2 id="skills-title">
            A practical toolkit.
          </h2><p>
            Technologies used across my development and infrastructure work.
          </p>
        </div><div class="skills-grid">
          {
            skills.map((group) => (
              <div>
                <>
                  <h3>{group.title}</h3>
                  <ul>
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="testimonials"
      class="section wrap"
      aria-labelledby="testimonials-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">04 / Working together</p><h2
            id="testimonials-title"
          >
            From the people<br /><em>I've worked with.</em>
          </h2>
        </div>
      </div><div class="testimonials-grid">
        {
          testimonials.map((item) => (
            <figure>
              <>
                <blockquote>“{item.text}”</blockquote>
                <figcaption>
                  <>
                    <strong>{item.author}</strong>
                    <span>{item.role}</span>
                  </>
                </figcaption>
              </>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="writing-section section" aria-labelledby="writing-title">
      <div class="wrap">
        <div class="section-heading">
          <div>
            <p class="eyebrow">05 / Field notes</p><h2 id="writing-title">
              What production<br /><em>has taught me.</em>
            </h2>
          </div><a class="text-link" href="/blog/"
            >All writing <span aria-hidden="true">↗</span></a>
        </div><div class="writing-list">
          {
            posts.map((post) => (
              <article>
                <a href={`/blog/${stripLocalePrefix(post.slug, "en")}/`}>
                  <>
                    <div class="writing-meta">
                      <>
                        <span>{post.data.category}</span>
                        <time datetime={post.data.pubDate.toISOString()}>
                          {date.format(post.data.pubDate)}
                        </time>
                      </>
                    </div>
                    <div>
                      <>
                        <h3>{post.data.title}</h3>
                        <p>{post.data.description}</p>
                      </>
                    </div>
                    <span class="circle-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="contact"
      class="section wrap contact-section"
      aria-labelledby="contact-title"
    >
      <div class="contact-copy">
        <p class="eyebrow">06 / Start a conversation</p><h2 id="contact-title">
          What are you<br /><em>working on?</em>
        </h2><p>
          A system that needs to be more reliable, a delivery process to
          improve, or a role where software and operations meet. I'd like to
          hear about it.
        </p><a class="contact-email" href={`mailto:${profile.email}`}
          >{profile.email} <span aria-hidden="true">↗</span></a
        ><div class="contact-socials">
          <a class="text-link" href={profile.linkedin}>LinkedIn ↗</a><a
            class="text-link"
            href={profile.github}>GitHub ↗</a>
        </div>
      </div><ContactForm />
    </section>
  </main>
</Layout>
