---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ContactCallout from "../../components/ContactCallout.astro";
const projects = (
  await getCollection("projects", ({ id }) => id.startsWith("en/"))
).sort((a, b) => {
  if (a.slug.endsWith("systemframe")) return -1;
  if (b.slug.endsWith("systemframe")) return 1;
  return a.data.order - b.data.order;
});
---

<Layout
  title="Projects & Case Studies — Hélio Fernandes"
  description="Real work across observability, automated delivery, and software engineering. Explore the context, technical decisions, and results behind each project."
  canonicalUrl="https://heliosuns404.com/projects/"
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow"><a href="/">Home</a> / Selected work</p><h1>
          Systems I've built.<br />Decisions I've made.
        </h1><p class="page-description">
          From application code to production infrastructure. Each case study
          covers the problem, my contribution, the outcome, and what I learned
          along the way.
        </p>
      </div>
    </section><section class="section wrap" aria-label="Project case studies">
      <div class="projects-grid">
        {
          projects.map((project) => (
            <ProjectCard project={project} heading="h2" />
          ))
        }
      </div>
    </section><ContactCallout />
  </main>
</Layout>
