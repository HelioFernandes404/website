---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ArchitectureFlow from "../../components/ArchitectureFlow";
import ContactCallout from "../../components/ContactCallout.astro";
import { stripLocalePrefix } from "../../i18n/utils";
export async function getStaticPaths() {
  return (
    await getCollection("projects", ({ id }) => id.startsWith("en/"))
  ).map((project) => ({
    params: { slug: stripLocalePrefix(project.slug, "en") },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { Content } = await project.render();
const { carl, architecture } = project.data;
const slug = stripLocalePrefix(project.slug, "en");
const sections = carl
  ? [
      { label: "The context", body: carl.context },
      { label: "My contribution", body: carl.action },
      { label: "The outcome", body: carl.result },
      { label: "What I learned", body: carl.learning },
    ]
  : [];
---

<Layout
  title={`${project.data.title} — Case Study | Hélio Fernandes`}
  description={project.data.description}
  ogImage={project.data.image}
  canonicalUrl={`https://heliosuns404.com/projects/${slug}/`}
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">
          <a href="/projects/">Selected work</a> / {
            project.data.category.replace(/^\d+\.\s*/, "")
          }
        </p><h1>{project.data.title}</h1><p class="page-description">
          {project.data.description}
        </p><ul class="tech-tags" aria-label="Technologies">
          {project.data.tech.map((item) => <li>{item}</li>)}
        </ul><div class="project-outcome case-outcome">
          <strong>{project.data.metricValue}</strong><div>
            <span>{project.data.metricLabel}</span><span
              >{project.data.metricCaption.replace(/\s*->\s*/, " → ")}</span>
          </div>
        </div>{
          (project.data.url || project.data.secondaryUrl) && (
            <div class="case-external-links">
              {project.data.url && (
                <a
                  class="button button-primary"
                  href={project.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.data.urlLabel ?? "Visit project"} (opens in a new tab)`}
                >
                  {project.data.urlLabel ?? "Visit project"}{" "}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              {project.data.secondaryUrl && (
                <a
                  class="text-link"
                  href={project.data.secondaryUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.data.secondaryUrlLabel ?? "View context"} (opens in a new tab)`}
                >
                  {project.data.secondaryUrlLabel ?? "View context"}{" "}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )
        }
      </div>
    </section>
    <section class="wrap case-body" aria-label="Case study">
      {
        sections.length > 0 && (
          <ol class="case-story">
            {sections.map((section, index) => (
              <li>
                <h2>
                  0{index + 1} / {section.label}
                </h2>
                <p>{section.body}</p>
              </li>
            ))}
          </ol>
        )
      }
      {
        architecture && (
          <section
            class="case-architecture"
            aria-labelledby="architecture-title"
          >
            <>
              <h2 id="architecture-title">{architecture.title}</h2>
              <p>
                Explore the components, the decisions behind them, and the
                trade-offs involved.
              </p>
              <div>
                <ArchitectureFlow
                  client:visible
                  nodes={architecture.nodes}
                  edges={architecture.edges}
                  hint={architecture.hint}
                  lang="en"
                />
              </div>
              <details class="case-decisions">
                <>
                  <summary>Read all architecture decisions</summary>
                  <dl>
                    {architecture.nodes
                      .filter((node) => node.decision)
                      .map((node) => (
                        <div>
                          <dt>{node.label}</dt>
                          <dd>{node.decision}</dd>
                          {node.tradeoff && (
                            <dd>
                              <strong>Trade-off:</strong> {node.tradeoff}
                            </dd>
                          )}
                        </div>
                      ))}
                  </dl>
                </>
              </details>
            </>
          </section>
        )
      }
      <article class="article-content case-article"><Content /></article><a
        href="/projects/"
        class="text-link"
        ><span aria-hidden="true">←</span> Back to all projects</a
      >
    </section><ContactCallout />
  </main>
</Layout>
