    <p class="eyebrow">404 / Page not found</p><h1 class="error-title">
      This page has moved<br />or doesn't exist.
    </h1><p class="page-description">
      You can find my work, writing, and contact details from the homepage.
    </p><div class="hero-actions">
      <a class="button button-primary" href="/"
        >Back to home <span aria-hidden="true">↗</span></a
      ><a class="text-link" href="/#contact">Get in touch</a>
    </div>
  </main>
</Layout>
