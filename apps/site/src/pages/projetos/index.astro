---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

// Curated order, not alphabetical: the first card is the one worth reading first.
const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);

const title = "Projetos | Hélio Fernandes";
const description =
    "Projetos de engenharia de software, infraestrutura cloud e automacao com foco em performance e confiabilidade.";
const ogImage = "/og-image.webp";
const canonicalUrl = "https://heliosuns404.com/projetos/";
---

<Layout
    title={title}
    description={description}
    ogImage={ogImage}
    canonicalUrl={canonicalUrl}
>
    <main class="min-h-screen">
        <section
            class="relative overflow-hidden border-b border-gray-100 bg-gray-50/70"
        >
            <div
                class="absolute -left-24 top-1/2 hidden h-80 w-80 -translate-y-1/2 rounded-full bg-brand-lime/10 blur-3xl lg:block"
            >
            </div>

            <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
                <span
                    class="flex items-center gap-2 font-mono text-sm uppercase tracking-wider text-brand-gray"
                >
                    <span class="h-px w-8 bg-brand-lime"></span>
                    Portfolio tecnico
                </span>
                <h1
                    class="mt-4 text-4xl font-display font-bold tracking-tight lg:text-5xl"
                >
                    Projetos
                </h1>
                <p class="mt-4 max-w-2xl text-lg text-gray-600">
                    Cada projeto abaixo tem o problema, a decisao tecnica e o
                    resultado. Sem lista de tecnologia solta.
                </p>
            </div>
        </section>

        <section class="mx-auto max-w-5xl px-6 py-16 md:py-20">
            {
                projects.length === 0 ? (
                    <p class="rounded-xl border border-gray-200 bg-white p-6 text-gray-600 shadow-sm">
                        Nenhum projeto publicado ainda.
                    </p>
                ) : (
                    <ul class="space-y-8">
                        {projects.map((project) => (
                            <li>
                                <article class="group relative overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-[transform,border-color,box-shadow] duration-300 hover:-translate-y-1 hover:border-brand-lime hover:shadow-xl">
                                    <a
                                        class="hover-trigger grid gap-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-lime md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]"
                                        href={`/projetos/${project.slug}/`}
                                    >
                                        <div class="relative h-48 overflow-hidden bg-gray-100 md:h-full md:min-h-[15rem]">
                                            <img
                                                src={project.data.image}
                                                alt={project.data.imageAlt}
                                                loading="lazy"
                                                decoding="async"
                                                class="h-full w-full object-cover grayscale transition-[filter,transform] duration-500 group-hover:grayscale-0 group-hover:scale-105"
                                            />
                                            {project.data.comingSoon && (
                                                <span class="absolute right-3 top-3 rounded bg-brand-lime px-2.5 py-1 font-mono text-xs font-bold text-black">
                                                    Coming Soon
                                                </span>
                                            )}
                                        </div>

                                        <div class="flex flex-col p-8">
                                            <span class="font-mono text-xs uppercase tracking-wider text-brand-gray">
                                                {project.data.category}
                                            </span>
                                            <h2 class="mt-2 text-2xl font-display font-bold tracking-tight">
                                                {project.data.title}
                                            </h2>
                                            <p class="mt-3 text-gray-600">
                                                {project.data.description}
                                            </p>

                                            <div class="mt-5 flex flex-wrap gap-2 font-mono text-xs">
                                                {project.data.tech.map(
                                                    (item) => (
                                                        <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-gray-600">
                                                            {item}
                                                        </span>
                                                    ),
                                                )}
                                            </div>

                                            <div class="mt-6 flex items-end justify-between gap-4 border-t border-gray-100 pt-5">
                                                <div>
                                                    <p class="font-mono text-[0.65rem] uppercase tracking-wider text-brand-gray">
                                                        {
                                                            project.data
                                                                .metricLabel
                                                        }
                                                    </p>
                                                    <p class="text-2xl font-display font-bold leading-tight">
                                                        {
                                                            project.data
                                                                .metricValue
                                                        }
                                                    </p>
                                                    <p class="font-mono text-[0.65rem] uppercase tracking-wider text-gray-400">
                                                        {
                                                            project.data
                                                                .metricCaption
                                                        }
                                                    </p>
                                                </div>

                                                <span
                                                    aria-hidden="true"
                                                    class="inline-flex items-center gap-2 font-medium text-gray-500 transition-[color,transform] duration-300 group-hover:translate-x-1 group-hover:text-black"
                                                >
                                                    Ver projeto -&gt;
                                                </span>
                                            </div>
                                        </div>
                                    </a>
                                </article>
                            </li>
                        ))}
                    </ul>
                )
            }
        </section>
    </main>
</Layout>
