---
import { profile } from "../data/profile";
// The original site only had mailto links. An optional public form endpoint
// enables direct delivery without changing the static Astro deployment.
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT?.trim() ?? "";
if (endpoint && !/^https:\/\//.test(endpoint) && !/^\/(?!\/)/.test(endpoint)) {
  throw new Error(
    "PUBLIC_CONTACT_ENDPOINT must be an HTTPS URL or a same-origin path.",
  );
}
---

<form
  id="contact-form"
  class="contact-form"
  action={endpoint || `mailto:${profile.email}`}
  method="post"
  enctype={endpoint ? "application/x-www-form-urlencoded" : "text/plain"}
  data-endpoint={endpoint}
  data-recipient={profile.email}
>
  <div class="form-row">
    <div class="form-field">
      <label for="contact-name">Name</label><input
        id="contact-name"
        name="name"
        autocomplete="name"
        placeholder="Your name"
        required
        maxlength="100"
        aria-describedby="name-error"
      /><p id="name-error" class="field-error"></p>
    </div>
    <div class="form-field">
      <label for="contact-email">Email</label><input
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="you@company.com"
        required
        maxlength="254"
        aria-describedby="email-error"
      /><p id="email-error" class="field-error"></p>
    </div>
  </div>
  <div class="form-field">
    <label for="contact-message">What are you working on?</label><textarea
      id="contact-message"
      name="message"
      rows="5"
      placeholder="A reliability challenge, a project, or a role you'd like to discuss…"
      required
      maxlength="5000"
      aria-describedby="message-error"></textarea><p
      id="message-error"
      class="field-error"
    >
    </p>
  </div>
  <div class="form-bottom">
    <button class="button button-primary" type="submit"
      ><span data-submit-label
        >{endpoint ? "Send message" : "Continue to email"}</span
      ><span aria-hidden="true">↗</span></button
    ><p>
      {
        endpoint
          ? "I'll use your details to reply to your message."
          : "Opens an email draft for you to review and send."
      }
    </p>
  </div>
  <p
    class="form-status"
    id="contact-status"
    role="status"
    aria-live="polite"
    tabindex="-1"
  >
  </p>
  <a
    class="text-link email-fallback"
    data-email-fallback
    href={`mailto:${profile.email}`}
    >Prefer email? {profile.email} <span aria-hidden="true">↗</span></a
  >
  <noscript
    ><p>
      You can also email <a href={`mailto:${profile.email}`}>{profile.email}</a> directly.
    </p></noscript
  >
</form>

<script>
  import {
    createContactMailto,
    submitContact,
    validateContact,
  } from "../utils/contact.js";
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  if (form) {
    form.noValidate = true;
    const status = form.querySelector<HTMLElement>("#contact-status")!;
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    )!;
    const label = form.querySelector<HTMLElement>("[data-submit-label]")!;
    const fallback = form.querySelector<HTMLAnchorElement>(
      "[data-email-fallback]",
    )!;
    const initialLabel = label.textContent;
    const names = ["name", "email", "message"] as const;
    form.addEventListener("input", (event) => {
      const field = event.target;
      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement
      ) {
        field.removeAttribute("aria-invalid");
        const error = document.getElementById(`${field.name}-error`);
        if (error) error.textContent = "";
      }
      status.textContent = "";
    });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (button.disabled) return;
      const data = new FormData(form);
      const values = {
        name: String(data.get("name") ?? ""),
        email: String(data.get("email") ?? ""),
        message: String(data.get("message") ?? ""),
      };
      const errors = validateContact(values) as Partial<
        Record<(typeof names)[number], string>
      >;
      names.forEach((name) => {
        document.getElementById(`${name}-error`)!.textContent =
          errors[name] ?? "";
        document
          .getElementById(`contact-${name}`)!
          .setAttribute("aria-invalid", String(Boolean(errors[name])));
      });
      const firstError = names.find((name) => errors[name]);
      if (firstError) {
        status.textContent = "Please check the highlighted fields.";
        document.getElementById(`contact-${firstError}`)?.focus();
        return;
      }
      fallback.href = createContactMailto(form.dataset.recipient!, values);
      if (!form.dataset.endpoint) {
        status.textContent =
          "Your email draft is ready. Send it from your email app to finish getting in touch. If the app didn't open, use the email link below.";
        status.dataset.state = "draft";
        window.location.href = fallback.href;
        status.focus({ preventScroll: true });
        return;
      }
      button.disabled = true;
      form.setAttribute("aria-busy", "true");
      label.textContent = "Sending…";
      status.textContent = "Sending your message…";
      try {
        await submitContact(form.dataset.endpoint, values);
        status.textContent =
          "Thank you. Your message has been sent. I'll reply to the email address you provided.";
        status.dataset.state = "success";
        form.reset();
        fallback.href = `mailto:${form.dataset.recipient}`;
      } catch {
        status.textContent =
          "Your message could not be sent. Your text is still here. Please try again or send it using the email link below.";
        status.dataset.state = "error";
      } finally {
        button.disabled = false;
        form.removeAttribute("aria-busy");
        label.textContent = initialLabel;
        status.focus({ preventScroll: true });
      }
    });
  }
</script>
