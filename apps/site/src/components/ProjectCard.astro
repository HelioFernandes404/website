---
import type { CollectionEntry } from "astro:content";
import { stripLocalePrefix } from "../i18n/utils";
interface Props {
  project: CollectionEntry<"projects">;
  heading?: "h2" | "h3";
}
const { project, heading: Heading = "h3" } = Astro.props;
const { data } = project;
const slug = stripLocalePrefix(project.slug, "en");
const isStudy = !data.carl;
---

<article class:list={["project-card", isStudy && "project-card--study"]}>
  <a class="project-card-link" href={`/projects/${slug}/`}>
    <div class="project-card-top">
      <span class="eyebrow"
        >{
          isStudy
            ? "Learning in public"
            : data.category.replace(/^\d+\.\s*/, "")
        }</span
      >
      <span class="circle-arrow" aria-hidden="true">↗</span>
    </div>
    <Heading>{data.title}</Heading>
    <p class="project-description">{data.description}</p>
    <ul class="tech-tags" aria-label="Technologies">
      {data.tech.map((tech) => <li>{tech}</li>)}
    </ul>
    <div class="project-outcome">
      <strong>{data.metricValue}</strong>
      <div>
        <span>{data.metricLabel}</span><span
          >{data.metricCaption.replace(/\s*->\s*/, " → ")}</span>
      </div>
    </div>
    <span class="text-link"
      >{isStudy ? "Explore the project" : "Read the case study"}
      <span aria-hidden="true">→</span></span
    >
    {data.comingSoon && <span class="project-status">In progress</span>}
  </a>
</article>
