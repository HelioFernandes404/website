---
interface Props { title?: string; headers: string[]; rows: string[][]; caption?: string; }

const pt = Astro.currentLocale === "pt" || Astro.url.pathname.startsWith("/pt/");
const { title = pt ? "Comparação" : "Comparison", headers, rows, caption } = Astro.props;
---

<section class="blog-comparison-table" aria-label={title}>
    <h2 class="blog-editorial-title">{title}</h2>
    <div class="blog-comparison-table__scroll">
        <table>
            {caption && <caption>{caption}</caption>}
            <thead><tr>{headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
            <tbody>
                {rows.map((row) => <tr>{row.map((cell, index) => (
                    index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>
                ))}</tr>)}
            </tbody>
        </table>
    </div>
</section>
