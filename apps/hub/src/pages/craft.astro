---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Craft | Helio Fernandes";
const description =
  "OpenFlashcards: a study project moving toward open source to explore spaced repetition, active learning, and public documentation.";
const site = Astro.site ?? new URL("https://hub.heliosuns404.com");
const craftUrl = new URL("/craft", site).toString();
const openflashcardsRepoUrl = "https://github.com/HelioFernandes404/openflashcards";
const openflashcardsSiteUrl = "https://openflashcards.heliosuns404.com/";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${craftUrl}#webpage`,
  name: title,
  url: craftUrl,
  description,
  inLanguage: "en",
  mainEntity: {
    "@type": "CreativeWork",
    name: "OpenFlashcards",
    url: openflashcardsSiteUrl,
    description:
      "Learning project that is opening up into open source to explore spaced repetition, active learning and product discovery in public.",
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/craft"
  currentPath="/craft"
  lang="en"
  jsonLd={jsonLd}
>
  <section class="intro-block">
    <h1>Craft</h1>
    <p class="intro-subtitle">Projects moving toward open source and experiments in progress.</p>
  </section>

  <section class="content-block">
    <h2>OpenFlashcards</h2>

    <ul class="entry-list">
      <li>
        <a
          class="entry-link"
          href={openflashcardsRepoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View the OpenFlashcards repository on GitHub"
        >
          <span class="entry-top">
            <span class="entry-title-wrap">
              <span class="entry-title">GitHub</span>
            </span>
            <span class="entry-actions">
              <span class="entry-tag">Repository</span>
              <span class="entry-arrow" aria-hidden="true">↗</span>
            </span>
          </span>
          <span class="entry-description">View the public repository and follow the code evolve.</span>
          <span class="entry-meta">Code • GitHub • Documentation</span>
        </a>
      </li>
      <li>
        <a
          class="entry-link"
          href={openflashcardsSiteUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open the OpenFlashcards project site"
        >
          <span class="entry-top">
            <span class="entry-title-wrap">
              <span class="entry-title">Site</span>
            </span>
            <span class="entry-actions">
              <span class="entry-tag">Project</span>
              <span class="entry-arrow" aria-hidden="true">↗</span>
            </span>
          </span>
          <span class="entry-description">Open the live project.</span>
          <span class="entry-meta">Real problem • Small scope • Public learning</span>
        </a>
      </li>
    </ul>

    <p class="intro-paragraph">
      OpenFlashcards is a study project moving toward open source. It started from a real pain point in my learning
      process and became a lab for exploring spaced repetition, UX, and product decisions in public.
    </p>
    <p class="intro-paragraph">
      The goal is not to operate a parallel SaaS. The project stays small, documented, and useful for studying the
      problem, measuring what matters, and sharing what I learn.
    </p>
  </section>
</BaseLayout>
